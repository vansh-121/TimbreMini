<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Applied before Compose takes over; a dark window background avoids a
         white flash on cold start. -->
    <style name="Theme.TimbreMini" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
